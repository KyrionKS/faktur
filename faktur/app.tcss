/* Das Aussehen der ganzes App.
 *
 * Die Farben stehen hier als Text, weil Textual das Stylesheet liest und
 * keine Python-Konstanten kennt. Die Werte kommen aus faktur/farben.py,
 * wo auch der gemessene Kontrast steht. #C9B5E3 hat 7.28:1 gegen den
 * dunklen Grund. Das Violett aus dem Logo, #512E80, hat dort nur 1.33:1
 * und gehört ausschliesslich auf die PDF.
 *
 * Alles andere ist ruhig: eine Zeile Abstand, keine Kästen, kein Schatten. */

Screen {
    background: $surface;
    color: $text;
    padding: 1 0 0 0;
}

.logo {
    height: auto;
    padding: 0 2;
    color: #C9B5E3;
}

#inhalt {
    height: 1fr;
    padding: 1 2;
}

#hinweis {
    width: 1fr;
    padding: 0 0 1 0;
    color: $text-muted;
    text-style: italic;
}

/* Die Liste im Hauptmenü */

.auswahl {
    height: auto;
    width: 1fr;
    padding: 0 1;
}

.tabelle {
    height: auto;
    width: 1fr;
    padding: 0 1;
}

/* Das Formular aus mehreren Feldern.
 *
 * Ohne diese Zeile hat das Programm seine unteren Felder abgeschnitten und
 * sich nicht rollen lassen. ``Formular`` erbt von ``Vertical``, und das ist
 * von Haus aus ``1fr``: Es schrumpft in die Hoehe hinein, statt ueberzustehen.
 * Damit bekam der ``VerticalScroll`` darueber nichts zu rollen, es erschien
 * kein Balken, und wer bei einem Fenster von 34 Zeilen ein Kundenformular
 * mit acht Feldern ausfuellt, sah drei davon. */

.formular {
    height: auto;
}

/* Beschriftungen neben Eingabefeldern */

.bezeichnung {
    width: 22;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

.zeile {
    height: 3;
    width: 1fr;
}

Input {
    width: 1fr;
    height: 3;
    border: tall #8A76A5;
    padding: 0 1;
}

/* Das Fenster mit einer Ja-Nein-Frage */

#fenster {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round #C9B5E3;
}

#fenster_titel {
    text-style: bold;
    color: #C9B5E3;
    padding-bottom: 1;
}

#fenster_text {
    padding-bottom: 1;
}

#fenster_knopf {
    height: 1;
}

#knopf_ja {
    width: 22;
    color: $text;
}

#knopf_nein {
    width: 22;
    color: $text-muted;
}

/* Die Zusammenfassung vor dem Speichern */

.summe {
    padding: 0 0 1 0;
}


.summe_wert {
    color: #C9B5E3;
    text-style: bold;
}

Footer {
    background: $panel;
    color: $text-muted;
}

/* Das Suchfeld über einer Liste.
 *
 * Ohne Rahmen. Ein Kasten um ein Feld, das man nur beim Suchen benutzt,
 * waere lauter als die Liste darunter, nach der man eigentlich sucht. */

#suche {
    height: 1;
    border: none;
    padding: 0;
}

#suche:focus {
    border: none;
}

